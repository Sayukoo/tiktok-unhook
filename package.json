{
  "name": "offhook",
  "version": "2.0.0",
  "description": "Offhook - distraction-free focus mode for TikTok on desktop (Chrome & Firefox)",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt --browser firefox",
    "build": "wxt build",
    "build:firefox": "wxt build --browser firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip --browser firefox",
    "compile": "tsc --noEmit",
    "test": "node --import ./tests/resolve-ts.mjs --test \"tests/*.test.mjs\"",
    "e2e": "node scripts/e2e.js",
    "icons": "node scripts/generate-icons.js",
    "promo": "node scripts/generate-store-assets.js",
    "promo:video": "node scripts/generate-promo-video.js",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "ffmpeg-static": "^5.3.0",
    "playwright-core": "^1.65.1",
    "postcss": "^8.5.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "wxt": "^0.19.28"
  }
}
